namespace BibliotecaFinanceira
{
    public class CalculadoraJuros
    {
        public double JurosSimples(double capital, double taxa, double tempo)
        {
            return capital * taxa * tempo;
        }

        internal double CalculoInterno(double valor)
        {
            return valor * 2;
        }
    }
}

//projeto console//
program.cs: 
using BibliotecaFinanceira;

class Program
{
    static void Main(string[] args)
    {
        CalculadoraJuros calculadora = new CalculadoraJuros();

        double juros = calculadora.JurosSimples(1000, 0.05, 2);

        Console.WriteLine($"Juros simples: {juros}");

        double resultado = calculadora.CalculoInterno(10);

        Console.WriteLine($"Resultado interno: {resultado}");
    }
}

