Validador.cs: 
using System;
using System.Collections.Generic;
using System.Text;

namespace BibliotecaValidacoes
{
    public class Validador
    {
        public bool ValidadorCPF(string cpf)
        {
            return cpf.Length == 11;
        }

        public bool ValidadorEmail(string email, string dominio)
        {
            return email.Contains("@") && email.EndsWith(dominio);
        }

        public bool ValidadorSenha(string senha)
        {
            return senha.Length >= 8;
        }
    }
}

program.cs: 
using BibliotecaValidacoes;

class Program
{
    static void Main(string[] args)
    {
        Validador validador = new Validador();

        Console.Write("Digite o CPF: ");
        string cpf = Console.ReadLine();

        Console.Write("Digite o e-mail: ");
        string email = Console.ReadLine();

        Console.Write("Digite a senha: ");
        string senha = Console.ReadLine();

        bool cpfValido = validador.ValidadorCPF(cpf);
        bool emailValido = validador.ValidadorEmail(email);
        bool senhaValida = validador.ValidadorSenha(senha);

        Console.WriteLine();

        Console.WriteLine($"CPF válido: {cpfValido}");
        Console.WriteLine($"E-mail válido: {emailValido}");
        Console.WriteLine($"Senha válida: {senhaValida}");

        Console.ReadKey();
    }
}


