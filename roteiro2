using System;
using System.Collections.Generic;
using System.IO;
using System.Xml.Serialization;

public class Produto
{
    public string Nome { get; set; }
    public double Preco { get; set; }
}

class Program
{
    static void Main()
    {
        List<Produto> produtos = new List<Produto>
        {
            new Produto
            {
                Nome = "Mouse",
                Preco = 199.90
            },

            new Produto
            {
                Nome = "Teclado",
                Preco = 299.90
            },

            new Produto
            {
                Nome = "Headset",
                Preco = 249.90
            }
        };

        XmlSerializer serializer =
            new XmlSerializer(typeof(List<Produto>));

        using (StreamWriter writer =
               new StreamWriter("produtos.xml"))
        {
            serializer.Serialize(writer, produtos);
        }

        Console.WriteLine("XML criado com sucesso!");
    }
}

//exercicio 3// 
using System;
using System.Xml.Linq;

class Program
{
    static void Main()
    {
        XDocument doc = XDocument.Load("estoque.xml");

        var item = doc.Descendants("item")
                       .FirstOrDefault(x =>
                           x.Element("nome").Value == "Mouse");

        if (item != null)
        {
            item.Element("quantidade").Value = "10";
        }

        doc.Save("estoque.xml");

        Console.WriteLine("Estoque atualizado!");
    }
}

